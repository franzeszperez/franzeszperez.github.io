---
import '../styles/global.css';
import { profile } from '../data/resume';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const site = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, site);

/**
 * The share card, generated by `npm run og` from resume.ts — see
 * scripts/og-image.mjs. Scrapers require an absolute URL and most ignore a
 * relative one outright, so this resolves against `site` in astro.config.mjs.
 * Regenerate it after changing the name, headline or role count.
 */
const ogImage = new URL('/og.png', site);

/**
 * Describes the card itself, not the page — this is read aloud in place of the
 * image, so repeating `description` here would say the summary twice.
 */
const ogImageAlt = `An instruction-booklet cover in blue and black: "Android + Backend", ${profile.headline}, ${profile.location}.`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Mobile browser chrome takes the booklet's own stock colour. -->
		<meta name="theme-color" content="#1e8ac4" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<!-- Open Graph: controls how the link looks when shared, e.g. on LinkedIn. -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={profile.name} />
		<meta property="og:image" content={ogImage} />
		<!-- Dimensions let LinkedIn and Slack reserve the right box before the
		     image itself has downloaded, so the card does not reflow. -->
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />
	</head>
	<body>
		<a href="#main" class="skip">Skip to content</a>
		<!-- The running head is a banner landmark outside main, so that
		     skipping to content actually clears the navigation. -->
		<slot name="banner" />
		<main id="main">
			<slot />
		</main>
	</body>
</html>
