---
/**
 * The assembly steps in full. Newest role first — the step numbers count down
 * as you scroll, because a recruiter wants today's role at the top and the
 * sequence still carries real information: it is the order it was built in.
 */
import { experience } from '../data/resume';
import { rolesNewestFirst } from '../lib/stats';
import { formatRange } from '../lib/dates';

const steps = rolesNewestFirst;
const total = experience.length;
---

<section class="section" id="experience" aria-labelledby="experience-label">
	<h2 id="experience-label">Roles</h2>

	<!-- reversed: the visible numerals count 05 down to 01, so the list's own
	     numbering should agree with what is drawn. -->
	<ol class="steps" reversed>
		{
			steps.map((job, i) => {
				const stepNo = total - i;
				const isCurrent = job.end === null;
				return (
					<li class="step-row seats">
						<div class="step-row__no">
							<span class="step-no" aria-hidden="true">
								{String(stepNo).padStart(2, '0')}
							</span>
							<span class="visually-hidden">
								Step {stepNo} of {total}
							</span>
						</div>

						<div class="step-row__body">
							<h3>
								{job.company}
								{isCurrent && <span class="step-row__live">Current</span>}
							</h3>
							<p class="step-row__role">{job.role}</p>
							<p class="step__meta">
								<time datetime={job.start}>{formatRange(job.start, job.end)}</time>
								<span>{job.location}</span>
							</p>

							<p class="step-row__scope">{job.summary}</p>

							<ul class="step-row__highlights">
								{job.highlights.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</div>

						<!--
							The spec column. A sibling of the body rather than a child of
							it, so it can take the third grid track and sit beside the
							prose: the prose is capped at its measure, and without this
							the whole right half of the row was empty stock.
						-->
						<div class="step-row__panels">
							<div
								class={`callout step-row__panel step-row__panel--parts${isCurrent ? ' step-row__panel--live' : ''}`}
							>
								<h4 class="callout__label">Skills used</h4>
								<ul class="chips">
									{job.stack.map((tech) => (
										<li class="chip">{tech}</li>
									))}
								</ul>
							</div>

							{job.apps && job.apps.length > 0 && (
								<div class="callout step-row__panel step-row__panel--shipped">
									<h4 class="callout__label">Shipped</h4>
									<ul class="step-row__apps">
										{job.apps.map((app) => (
											<li class="leader">
												<span class="leader__name">
													{app.url ? (
														<a href={app.url} rel="noopener">
															{app.name}
														</a>
													) : (
														app.name
													)}
												</span>
												<span class="leader__fill" aria-hidden="true" />
											</li>
										))}
									</ul>
								</div>
							)}
						</div>
					</li>
				);
			})
		}
	</ol>
</section>

<style>
	.steps {
		display: flex;
		flex-direction: column;
		margin-top: clamp(1.6rem, 3.4vw, calc(var(--stud) * 1.2));
	}

	/*
	 * Three tracks: the numeral, the prose, and the spec panels beside it.
	 *
	 * The prose track is sized to the measure it is already capped at —
	 * 13.5 stud is 540px, which is where calc(59ch + 1.5rem) lands at this
	 * font size. Giving the text a track its own width rather than 1fr is the
	 * whole point: a 1fr prose column on a 1360px sheet left ~565px of empty
	 * stock on every line, because the measure cap stops the text long before
	 * the column ends. The panels now spend that width instead.
	 */
	.step-row {
		display: grid;
		grid-template-columns:
			minmax(0, 7rem)
			minmax(0, calc(var(--stud) * 13.5))
			minmax(0, 1fr);
		gap: clamp(1rem, 2.4vw, 2rem);
		padding-block: clamp(1.6rem, 3.4vw, calc(var(--stud) * 1.1));
		border-top: var(--keyline-thin) dashed var(--ghost-line);
	}

	.step-row:first-child {
		border-top: none;
		padding-top: 0;
	}

	.step-row__no .step-no {
		font-size: clamp(3rem, 5.6vw, 5.4rem);
		-webkit-text-stroke: 4px var(--ink);
	}

	.step-row__body {
		min-width: 0;
	}

	.step-row__body h3 {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.7rem;
		font-size: clamp(1.5rem, 2.6vw, 2.1rem);
	}

	/* The current step is the only place red appears in this section. */
	.step-row__live {
		padding: 0.26rem 0.6rem;
		background: var(--new);
		color: var(--paper);
		/* 0.7rem = 11.2px: the legibility floor for functional text. This is
		   a status label, not smallprint, so it does not get the 10px one. */
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.step-row__role {
		margin-top: 0.3rem;
		font-size: 1.02rem;
		font-weight: 700;
	}

	.step-row__scope {
		margin-top: 0.9rem;
		/* Calibrated for Archivo's condensed figures — see --measure. */
		max-width: 52ch;
		font-weight: 500;
	}

	/* The measure is set on the item, not the list: ch units resolve against
	   the element's own font size, and these items are smaller than the list
	   box, so a measure on the parent lets lines run to ~87 characters. */
	.step-row__highlights {
		display: flex;
		flex-direction: column;
		gap: 0.62rem;
		margin-top: 1.1rem;
	}

	/* Each highlight is a sub-step, marked by a drawn stud rather than a
	   bullet glyph. */
	.step-row__highlights li {
		position: relative;
		padding-left: 1.5rem;
		/* Archivo is condensed, so its '0' is 1.29x the average character
		   width: 74ch measured out at 87 real characters. 59ch lands near 76,
		   and the stud's gutter is added back on top of the measure. */
		max-width: calc(59ch + 1.5rem);
		font-size: 0.95rem;
		font-weight: 500;
		text-wrap: pretty;
	}

	/* A stud seen from above: filled, not an outline. An empty square here
	   reads as an unchecked box — the opposite of "shipped". */
	.step-row__highlights li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.46em;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--ink);
		box-shadow: inset 0 0 0 2.5px var(--ground);
		outline: 2.5px solid var(--ink);
	}

	/* In the third track the panels stack rather than sit side by side: the
	   track is narrower than the two of them in a row, and stacking lets each
	   one size to its own content. They align with the company name rather
	   than the row top, so the heading still leads the row on its own. */
	.step-row__panels {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0.9rem;
		/* Clears the h3's cap-height so the first panel's label sits on the
		   same line as the role, not the company. */
		margin-top: 0.4rem;
	}

	.step-row__panel {
		min-width: 0;
		padding: 1rem 1.1rem;
	}

	.step-row__panel--live {
		border-color: var(--new);
	}

	/*
	 * Below the three-column threshold the panels drop back under the prose,
	 * where they read side by side again as they did before. Kept in sync with
	 * the grid change in the 1100px query.
	 */
	@media (max-width: 1100px) {
		.step-row__panels {
			flex-direction: row;
			flex-wrap: wrap;
			align-items: flex-start;
			margin-top: 1.4rem;
			max-width: var(--measure);
		}

		.step-row__panel {
			flex: 1 1 auto;
		}

		.step-row__panel--parts {
			flex: 2 1 22rem;
		}

		.step-row__panel--shipped {
			flex: 1 1 11rem;
			max-width: 20rem;
		}
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.44rem;
		margin-top: 0.8rem;
	}

	/* A part still on the sprue: small, ink-edged, countable. */
	.chip {
		padding: 0.3rem 0.58rem;
		border: var(--keyline-thin) solid var(--ink);
		background: rgba(30, 138, 196, 0.14);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	.step-row__apps {
		margin-top: 0.7rem;
	}

	.step-row__apps a {
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}

	.step-row__apps a:hover,
	.step-row__apps a:focus-visible {
		color: var(--new);
	}

	/*
	 * Below this the third track would squeeze the prose under its measure, so
	 * the row folds back to numeral + body and the panels rejoin the body
	 * column beneath the highlights — the layout this section had before.
	 */
	@media (max-width: 1100px) {
		.step-row {
			grid-template-columns: minmax(0, 7rem) minmax(0, 1fr);
		}

		.step-row__panels {
			/* Second column, under the body: the numeral track stays empty so
			   the panels keep the prose's left edge. */
			grid-column: 2;
		}
	}

	@media (max-width: 720px) {
		.step-row {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.4rem;
		}

		.step-row__panels {
			grid-column: 1;
		}

		.step-row__no .step-no {
			-webkit-text-stroke: 3px var(--ink);
		}
	}
</style>
